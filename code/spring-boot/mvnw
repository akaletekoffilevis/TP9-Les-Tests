#!/bin/sh
# Maven Wrapper minimaliste : utilise Maven s'il est déjà installé,
# sinon télécharge Apache Maven 3.9.9 dans .mvn/.
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION="3.9.9"
MAVEN_HOME="${BASE_DIR}/.mvn/apache-maven-${MAVEN_VERSION}"

if [ -x "${MAVEN_HOME}/bin/mvn" ]; then
  exec "${MAVEN_HOME}/bin/mvn" "$@"
fi

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

mkdir -p "${BASE_DIR}/.mvn"
ARCHIVE="${BASE_DIR}/.mvn/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
URL="https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz"

echo "Téléchargement de Maven ${MAVEN_VERSION}..." >&2
curl -fsSL "${URL}" -o "${ARCHIVE}"
tar -xzf "${ARCHIVE}" -C "${BASE_DIR}/.mvn"
rm -f "${ARCHIVE}"

exec "${MAVEN_HOME}/bin/mvn" "$@"
